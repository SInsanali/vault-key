#!/usr/bin/env bash
# Tries the built installer in Windows Sandbox, a throwaway copy of Windows: runs
# packaging/installer-check.ps1 and packaging/upgrade-check.ps1 (over the last release)
# there, and takes screenshots of the installed app.
#
#   scripts/sandbox-check      uses dist/release from scripts/package; results go to dist/sandbox/
#
# Needs Windows Sandbox turned on (Windows Pro). Nothing on this PC is installed or changed.
set -euo pipefail
repo="$(cd "$(dirname "$0")/.." && pwd)"
version="$(sed -n 's/^version *= *"\([^"]*\)".*/\1/p' "$repo/Cargo.toml" | head -1)"
setup="$repo/dist/release/VaultKey-Setup-$version.exe"
[ -f "$setup" ] || { echo "Missing $setup. Run scripts/package first." >&2; exit 1; }
temp="$(wslpath "$(cmd.exe /c 'echo %TEMP%' 2>/dev/null | tr -d '\r')")"
box="$(mktemp -d "$temp/vk-sandbox-XXXXXX")"
cp "$setup" "$repo/packaging/installer-check.ps1" "$repo/packaging/upgrade-check.ps1" "$repo/packaging/sandbox-check.ps1" "$box/"
# The last published installer, for the upgrade check (checked against its SHA256SUMS.txt).
old_arg=""
mkdir -p "$box/old"
if gh release download --repo SInsanali/vault-key --pattern 'VaultKey-Setup-*.exe' --pattern SHA256SUMS.txt --dir "$box/old" 2>/dev/null \
  && (cd "$box/old" && grep -E '  VaultKey-Setup-[0-9.]+\.exe$' SHA256SUMS.txt | sha256sum --check --quiet); then
  old_arg=" -OldSetup C:\\vk\\old\\$(cd "$box/old" && ls VaultKey-Setup-*.exe | head -1)"
else
  echo "The last release's installer could not be downloaded and checked; skipping the upgrade check." >&2
fi
cat > "$box/check.wsb" <<WSB
<Configuration>
  <MappedFolders>
    <MappedFolder><HostFolder>$(wslpath -w "$box")</HostFolder><SandboxFolder>C:\\vk</SandboxFolder><ReadOnly>false</ReadOnly></MappedFolder>
  </MappedFolders>
  <LogonCommand><Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\\vk\\sandbox-check.ps1 -Version $version$old_arg</Command></LogonCommand>
</Configuration>
WSB
(cd "$box" && cmd.exe /c start "" check.wsb)
echo "Windows Sandbox is starting; this takes a few minutes."
for _ in $(seq 1 180); do
  [ -f "$box/out/done.txt" ] && break
  sleep 5
done
mkdir -p "$repo/dist/sandbox"
rm -f "$repo/dist/sandbox/"*
cp "$box/out/"* "$repo/dist/sandbox/" 2>/dev/null || true
# Windows may still hold a file in it for a moment; the temp folder is cleaned up later anyway.
rm -rf "$box" 2>/dev/null || true
tr -d '\r' < "$repo/dist/sandbox/log.txt" | grep -E '^(PASS|FAIL|SKIP|ERROR|WARN|INSTALLER|UPGRADE|SANDBOX|==|after|  log:)' 2>/dev/null || { echo "The sandbox did not finish." >&2; exit 1; }
grep -q '^SANDBOX CHECK PASSED' "$repo/dist/sandbox/log.txt"
